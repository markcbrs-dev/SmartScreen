# .env.example — copy this to .env and fill in the values before running.
# NEVER commit .env to source control (it is already in .gitignore).
#
# Generate a secret key with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"

# ── Required ──────────────────────────────────────────────────────────────────

# Django secret key — must be a long, random string. No default in production.
SECRET_KEY=replace-this-with-a-generated-key

# Optional dedicated encryption key for applicant PII and uploaded resumes.
# If unset, the app derives encryption from SECRET_KEY to keep deployment simple.
# Set this separately in production so app data can be rotated independently.
# SMARTSCREEN_DATA_KEY=replace-this-with-a-generated-key

# ── Development only (set to True locally, leave unset or False in production) ─

DJANGO_DEBUG=True

# ── Hosting ───────────────────────────────────────────────────────────────────

# Comma-separated list of hostnames the server will respond to.
# Example: ALLOWED_HOSTS=example.com,www.example.com
ALLOWED_HOSTS=127.0.0.1,localhost

# ── Database (required: PostgreSQL) ───────────────────────────────────────────

DB_NAME=smartscreen
DB_USER=smartscreen_user
DB_PASSWORD=replace-with-db-password
DB_HOST=127.0.0.1
DB_PORT=5432

# ── Optional NLP features ─────────────────────────────────────────────────────

# Set to 1 to enable spaCy NER for resume and job description parsing.
# Requires: pip install spacy && python -m spacy download en_core_web_sm
# SMARTSCREEN_ENABLE_SPACY=1

# Set to 1 to let the resume parser ask Gemini to fill missing fields after
# local PDF/DOCX extraction and heuristics run.
# Requires: GEMINI_API_KEY and google-genai in the project environment.
# SMARTSCREEN_ENABLE_GEMINI=1
# GEMINI_API_KEY=replace-with-gemini-api-key
# SMARTSCREEN_GEMINI_MODEL=gemini-2.5-flash

# Path to the trained spaCy textcat model (defaults to models/spacy_job_classifier/).
# SMARTSCREEN_TEXTCAT_MODEL_DIR=models/spacy_job_classifier
